{
    "manifest_version": 3,
    "name": "Image Editor",
    "version": "0.0.0",
    "description": "Crop, resize, rotate, and adjust images locally in your browser.",
    "icons": {
        "16": "icon-16.png",
        "32": "icon-32.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "action": {
        "default_title": "Open Image Editor",
        "default_icon": {
            "16": "icon-16.png",
            "32": "icon-32.png",
            "48": "icon-48.png",
            "128": "icon-128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none';"
    }
}
